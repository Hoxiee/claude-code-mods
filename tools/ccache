#!/usr/bin/env python3
"""Prompt-cache report for one Claude Code session, read from its transcript.

usage: ccache [session-id-prefix | path.jsonl]   (default: the newest session of this directory)

One API response is written to the transcript as several lines (one per content block)
with the same message.id and usage, so the lines are deduplicated before summing.
"""
import glob
import json
import os
import re
import sys
from datetime import datetime, timedelta, timezone


def project_dir():
    # Claude Code names a project's folder after its cwd with every non-alphanumeric as "-".
    name = re.sub(r"[^A-Za-z0-9]", "-", os.getcwd())
    return os.path.expanduser(f"~/.claude/projects/{name}")


def resolve(arg):
    if arg and os.path.isfile(arg):
        return arg
    files = glob.glob(project_dir() + "/*.jsonl")
    if arg:
        files = [f for f in files if os.path.basename(f).startswith(arg)]
    if not files:
        sys.exit(f"no session found in {project_dir()}")
    return max(files, key=os.path.getmtime)


def load(path):
    calls, order = {}, []
    with open(path) as f:
        for line in f:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            m = e.get("message")
            if e.get("type") != "assistant" or not isinstance(m, dict) or not m.get("usage"):
                continue
            if m.get("model") == "<synthetic>":
                continue
            key = m.get("id") or e.get("uuid")
            if key not in calls:
                order.append(key)
            calls[key] = (e.get("timestamp", ""), bool(e.get("isSidechain")), m)
    return [calls[k] for k in order]


def when(ts):
    return datetime.fromisoformat(ts.replace("Z", "+00:00"))


def main():
    path = resolve(sys.argv[1] if len(sys.argv) > 1 else None)
    rows = load(path)
    print(f"{path}  ({len(rows)} API calls)\n")
    print(f"{'#':>3} {'time':8} {'':2} {'new':>7} {'write':>7} {'read':>8} {'hit%':>5}  note")

    tot = dict(new=0, write=0, read=0)
    prev_read = None
    last_main = None
    for i, (ts, side, m) in enumerate(rows, 1):
        u = m["usage"]
        new, wr, rd = u.get("input_tokens", 0), u.get("cache_creation_input_tokens", 0), u.get("cache_read_input_tokens", 0)
        tot["new"] += new
        tot["write"] += wr
        tot["read"] += rd
        ctx = new + wr + rd
        note = ""
        if not side:
            if prev_read is not None and rd < prev_read * 0.5 and ctx > 5000:
                note = f"CACHE BREAK (read {prev_read} -> {rd})"
            elif i > 1 and rd == 0 and ctx > 5000:
                note = "COLD (read=0)"
            prev_read = rd
            last_main = (ts, u)
        local = when(ts).astimezone().strftime("%H:%M:%S") if ts else ""
        print(f"{i:>3} {local:8} {'sc' if side else '':2} {new:>7} {wr:>7} {rd:>8} {100 * rd / ctx if ctx else 0:>4.0f}%  {note}")

    ctx = sum(tot.values())
    print(f"\nTOTAL  new={tot['new']}  write={tot['write']}  read={tot['read']}")
    if ctx:
        print(f"session hit ratio = read/(new+write+read) = {100 * tot['read'] / ctx:.1f}%")
    if last_main:
        ts, u = last_main
        size = u.get("input_tokens", 0) + u.get("cache_creation_input_tokens", 0) + u.get("cache_read_input_tokens", 0)
        cc = u.get("cache_creation") or {}
        # The API reports which TTL a write used; the last one written is the one in force.
        ttl = timedelta(hours=1) if cc.get("ephemeral_1h_input_tokens") else timedelta(minutes=5) if cc.get("ephemeral_5m_input_tokens") else None
        print(f"cached prefix now = {size} tokens")
        if ttl and ts:
            end = when(ts) + ttl
            left = end - datetime.now(timezone.utc)
            state = f"{int(left.total_seconds() // 60)} min left" if left.total_seconds() > 0 else "expired"
            print(f"cache lives until {end.astimezone():%H:%M} ({'1h' if ttl.seconds == 3600 else '5m'} TTL, {state})")


main()
